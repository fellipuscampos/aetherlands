; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Aetherlands"
config/description="Prototipo de 4X medieval fantasia em 3D."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
TurnManager="*res://scripts/autoload/TurnManager.gd"
EventBus="*res://scripts/autoload/EventBus.gd"
SelectionManager="*res://scripts/autoload/SelectionManager.gd"
Settings="*res://scripts/autoload/Settings.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
