[gd_scene load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/ui/TitleScreen.gd" id="TitleScreen_gd"]
[ext_resource type="PackedScene" path="res://scenes/ui/LoadGameScreen.tscn" id="LoadGameScreen_scn"]
[ext_resource type="PackedScene" path="res://scenes/ui/SettingsScreen.tscn" id="SettingsScreen_scn"]
[ext_resource type="Texture2D" path="res://assets/ui/title_menu/kingdom_landscape_painted.png" id="Landscape"]
[ext_resource type="Shader" path="res://assets/ui/title_menu/atmosphere.gdshader" id="Atmosphere"]
[ext_resource type="Texture2D" path="res://assets/ui/title_menu/crest.svg" id="Crest"]
[ext_resource type="Texture2D" path="res://assets/ui/title_menu/icon_new.svg" id="NewIcon"]
[ext_resource type="Texture2D" path="res://assets/ui/title_menu/icon_load.svg" id="LoadIcon"]
[ext_resource type="Texture2D" path="res://assets/ui/title_menu/icon_settings.svg" id="SettingsIcon"]
[ext_resource type="Texture2D" path="res://assets/ui/title_menu/icon_quit.svg" id="QuitIcon"]

[sub_resource type="ShaderMaterial" id="Veil"]
shader = ExtResource("Atmosphere")

[node name="TitleScreen" type="Control"]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("TitleScreen_gd")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.025, 0.07, 0.087, 1)

[node name="MainPage" type="Control" parent="."]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture_filter = 1

[node name="Landscape" type="TextureRect" parent="MainPage"]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("Landscape")
expand_mode = 1
stretch_mode = 6

[node name="Veil" type="ColorRect" parent="MainPage"]
material = SubResource("Veil")
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(1, 1, 1, 1)

[node name="BrandPanel" type="MarginContainer" parent="MainPage"]
layout_mode = 0
mouse_filter = 2

[node name="BrandBox" type="VBoxContainer" parent="MainPage/BrandPanel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Heraldry" type="HBoxContainer" parent="MainPage/BrandPanel/BrandBox"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 16

[node name="Crest" type="TextureRect" parent="MainPage/BrandPanel/BrandBox/Heraldry"]
custom_minimum_size = Vector2(56, 56)
layout_mode = 2
mouse_filter = 2
texture = ExtResource("Crest")
expand_mode = 1
stretch_mode = 5

[node name="Kicker" type="Label" parent="MainPage/BrandPanel/BrandBox/Heraldry"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.79, 0.72, 0.55, 1)
text = "UM MUNDO
ENTRE ERAS"
vertical_alignment = 1

[node name="Brand" type="Label" parent="MainPage/BrandPanel/BrandBox"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.95, 0.82, 0.60, 1)
theme_override_colors/font_shadow_color = Color(0.015, 0.04, 0.05, 1)
theme_override_constants/shadow_offset_x = 4
theme_override_constants/shadow_offset_y = 4
text = "AETHERLANDS"

[node name="Description" type="Label" parent="MainPage/BrandPanel/BrandBox"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.73, 0.79, 0.72, 1)
text = "Construa seu reino. Escreva sua era."

[node name="CenterBox" type="CenterContainer" parent="MainPage"]
layout_mode = 0
mouse_filter = 2

[node name="Box" type="VBoxContainer" parent="MainPage/CenterBox"]
