text = "Versátil e Ambicioso"

[node name="RaceLoreLabel" type="RichTextLabel" parent="CenterBox/Box/RaceSection/RaceDetailPanel/RaceDetailBox"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
