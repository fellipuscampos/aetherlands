[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/SettingsScreen.gd" id="SettingsScreen_gd"]

[node name="SettingsScreen" type="Control"]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
visible = false
script = ExtResource("SettingsScreen_gd")

[node name="CenterBox" type="CenterContainer" parent="."]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="CenterBox"]
layout_mode = 2
theme_override_constants/separation = 16
custom_minimum_size = Vector2(360, 0)

[node name="TitleLabel" type="Label" parent="CenterBox/Box"]
layout_mode = 2
theme_type_variation = &"PanelTitle"
horizontal_alignment = 1
text = "Configurações"

[node name="MusicRow" type="HBoxContainer" parent="CenterBox/Box"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="MusicLabel" type="Label" parent="CenterBox/Box/MusicRow"]
layout_mode = 2
custom_minimum_size = Vector2(120, 0)
text = "Música"

[node name="MusicSlider" type="HSlider" parent="CenterBox/Box/MusicRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.0
max_value = 1.0
step = 0.05
value = 0.8

[node name="SfxRow" type="HBoxContainer" parent="CenterBox/Box"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SfxLabel" type="Label" parent="CenterBox/Box/SfxRow"]
layout_mode = 2
custom_minimum_size = Vector2(120, 0)
text = "Efeitos"

[node name="SfxSlider" type="HSlider" parent="CenterBox/Box/SfxRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.0
max_value = 1.0
step = 0.05
value = 1.0

[node name="VSyncRow" type="HBoxContainer" parent="CenterBox/Box"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="VSyncLabel" type="Label" parent="CenterBox/Box/VSyncRow"]
layout_mode = 2
custom_minimum_size = Vector2(120, 0)
text = "V-Sync"

[node name="VSyncCheckButton" type="CheckButton" parent="CenterBox/Box/VSyncRow"]
layout_mode = 2
button_pressed = true

[node name="DebugButton" type="Button" parent="CenterBox/Box"]
layout_mode = 2
