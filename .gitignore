# Godot 4+ specific ignores
.godot/
/android/
*.translation

# Imported/compiled resources
.import/
export.cfg
# export_presets.cfg é versionado de propósito — usado pelo workflow de
# deploy (.github/workflows/deploy.yml) pra exportar builds no CI.

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# OS / editor junk
.DS_Store
Thumbs.db
*.tmp
*.TMP
~*
*~RF*.TMP

# Build output local (export de teste) — builds de release de verdade vêm
# do workflow de deploy, anexados às GitHub Releases, não deste diretório.
/build/

# Art pipeline (Blender MCP): rendered animation frames are intermediate (re-rendered by the
# *_animation_previews.py scripts, ~2 GB) and Blender's .blend1 backups are noise. The animated GIF
# previews duplicate the versioned MP4s at ~15x the size, so only the MP4s are tracked.
art_source/
*.blend1
assets/generated/**/previews/animations/*.gif
